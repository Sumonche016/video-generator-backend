PORT=4000

LLM_PROVIDER=openai
IMAGEGEN_PROVIDER=openai
VIDEOGEN_PROVIDER=flow

OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# GoLogin antidetect browser profiles, already logged into Google, used by
# the Flow video provider to drive labs.google/fx/tools/flow via CDP.
# GOLOGIN_PROFILE_IDS is a comma-separated list: one profile = one account =
# one clip rendering at a time, so three ids means three clips generate
# simultaneously. GOLOGIN_PROFILE_ID is still honoured (added to the pool).
GOLOGIN_API_TOKEN=
GOLOGIN_PROFILE_IDS=
GOLOGIN_PROFILE_ID=

DEFAULT_BLOCK_SECONDS=8
DEFAULT_BATCH_SIZE=5

# Single shared login for the whole app. AUTH_TOKEN is a random string
# returned on successful login and checked on every other request.
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_TOKEN=

# Supabase (Postgres for state, Storage for media). Secret key from
# Supabase Dashboard > Project Settings > API Keys — keep it out of the
# frontend and out of source control, it bypasses Row Level Security.
SUPABASE_URL=https://ukpefkmymksznllpyhbw.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=project-assets
